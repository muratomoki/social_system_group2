# ===== 必須 =====

# Anthropic API キー
# https://console.anthropic.com から取得
ANTHROPIC_API_KEY=<ここにAPIキーを入力，実際のキーは入力しないこと>

# 冷蔵庫在庫管理システムのベースURL
FRIDGE_API_BASE_URL=http://localhost:9090

# ===== 任意 =====

# HTTPサーバーのポート番号 (デフォルト: 8080)
PORT=8080

# ユーザー設定の保存ファイルパス (デフォルト: ./data/preferences.json)
USER_PREFS_FILE_PATH=./data/preferences.json

# 使用するClaudeモデル (デフォルト: claude-opus-4-7)
CLAUDE_MODEL=claude-opus-4-7

# AIレスポンスのインメモリキャッシュ有効化 (デフォルト: true)
AI_CACHE_ENABLED=true

# デバッグモード: true かつ ANTHROPIC_API_KEY 未設定の場合はスタブAIを使用 (デフォルト: false)
DEBUG=false
